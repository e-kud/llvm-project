  ; ALL-NEXT:   RET 0, implicit $eax
  bb.1.entry:
    successors: %bb.2(0x40000000), %bb.3(0x40000000)
    liveins: $edi

    %0(s32) = COPY $edi
    %2(i32) = G_CONSTANT i32 0
    %3(i32) = G_CONSTANT i32 1
    %1(s1) = G_TRUNC %0(s32)
    G_BRCOND %1(s1), %bb.2
    G_BR %bb.3

  bb.2.if.then:
    $eax = COPY %2(i32)
    RET 0, implicit $eax

  bb.3.if.else:
    $eax = COPY %3(i32)
    RET 0, implicit $eax

